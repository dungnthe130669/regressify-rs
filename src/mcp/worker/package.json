{
  "name": "regressify-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "tsc --noEmit",
    "test": "node --test tests/worker.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "npm audit --audit-level=high && npm run check && npm test && npm run build",
    "deploy": "npm run verify && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
