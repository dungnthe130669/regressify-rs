{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regressify-mcp-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": false,
  "workers_dev": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  }
}