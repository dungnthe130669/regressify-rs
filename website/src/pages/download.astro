---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { downloadHref, formatSize, getRelease, getReleaseArchives } from '../lib/release';

// Facts on this page come from docs/desktop.md (Windows Installation and Updates,
// Build and Launch) and README.md. Only Windows x64 has an installer; release
// deployments also publish CLI and desktop archives for every built platform.
const release = await getRelease();
const latestHref = downloadHref(release);
const archives = await getReleaseArchives();
const platforms = [
  { id: 'windows', title: 'Windows', subtitle: 'x64 · Desktop & CLI', items: archives.filter((archive) => archive.target.endsWith('-msvc')) },
  { id: 'macos', title: 'macOS', subtitle: 'Apple silicon & Intel', items: archives.filter((archive) => archive.target.endsWith('-darwin')) },
  { id: 'linux', title: 'Linux', subtitle: 'x64 · glibc', items: archives.filter((archive) => archive.target.includes('-linux-')) },
];
const repoUrl = SITE.repoUrl;
const cloneUrl = repoUrl ? `${repoUrl}.git` : null;

const verify = release.status === 'available' ? `Get-FileHash .\\${release.fileName} -Algorithm SHA256` : '';
const windowsCliInstall = 'irm https://regressify.eshn.dev/install.ps1 | iex';
const unixCliInstall = 'curl -fsSL https://regressify.eshn.dev/install.sh | sh';

const fromSource = [
  cloneUrl ? `git clone ${cloneUrl}\ncd regressify-rs` : '# From a checkout of the Regressify repository',
  'cargo install --path .',
  'regressify install',
].join('\n');

const desktopFromSource = `cargo build --release --features gui --bin regressify-desktop`;
---

<BaseLayout title="Download" description="Download the Regressify desktop app and CLI for Windows, macOS, and Linux, or build them from source.">
  <div class="container page">
    <header class="heading">
      <div>
        <h1>Download Regressify</h1>
        <p class="muted">Desktop app and CLI. Chromium managed automatically.</p>
      </div>
      {release.status === 'available' && <span class="release-version">v{release.version}</span>}
    </header>

    <nav class="platform-nav" aria-label="Download platforms">
      <a href="#windows">Windows</a>
      <a href="#macos">macOS</a>
      <a href="#linux">Linux</a>
    </nav>

    {release.status !== 'available' && (
      <p class="notice" role="status">
        {release.status === 'unpublished'
          ? 'A release has not been published yet.'
          : 'Release details could not be verified when this page was built.'}
        {' '}<a href="#source-heading">Build from source</a> or try again later.
      </p>
    )}

    {platforms.map(({ id, title, subtitle, items }) => (
      <section id={id} class="platform" aria-labelledby={`${id}-heading`}>
        <div class="platform-overview">
          <div>
            <h2 id={`${id}-heading`}>{title}</h2>
            <p class="platform-subtitle">{subtitle}</p>
          </div>
          <div class="platform-actions">
            {id === 'windows' && release.status === 'available' && (
              <>
                <Button variant="primary" href={latestHref ?? release.url} rel="noopener">
                  <Icon name="download" /> Download installer
                </Button>
                <span class="file-size">{formatSize(release.size)} · Desktop &amp; CLI</span>
              </>
            )}
            {id !== 'windows' && items.filter((archive) => archive.application === 'desktop' && archive.format === 'zip')
              .sort((left, right) => Number(right.target.startsWith('aarch64')) - Number(left.target.startsWith('aarch64')))
              .map((archive) => (
              <Button href={archive.url} title={archive.fileName}>
                <Icon name="download" />
                {id === 'macos' ? (archive.target.startsWith('aarch64') ? 'Apple silicon' : 'Intel') : 'Download desktop'}
              </Button>
            ))}
          </div>
        </div>

        <div class="platform-content">
          <CodeBlock
            title={id === 'windows' ? 'PowerShell' : 'Terminal · Desktop & CLI'}
            code={id === 'windows' ? windowsCliInstall : unixCliInstall}
            lang={id === 'windows' ? 'powershell' : 'sh'}
          />
          <a class="script-link" href={id === 'windows' ? '/install.ps1' : '/install.sh'}>Review install script</a>

          {id === 'windows' && release.status === 'available' && (
            <details class="disclosure">
              <summary>Installer details &amp; verification <Icon name="arrow-right" size={14} /></summary>
              <div class="disclosure-content">
                <p class="muted small">Installs the desktop app, CLI, and managed Chromium without administrator rights. Open a new terminal after setup.</p>
                <dl class="details">
                  <div><dt>Version</dt><dd>{release.version}</dd></div>
                  <div><dt>File</dt><dd><code>{release.fileName}</code></dd></div>
                  <div><dt>Location</dt><dd><code>%LOCALAPPDATA%\Programs\Regressify</code></dd></div>
                  <div><dt>SHA-256</dt><dd><code class="hash">{release.sha256}</code></dd></div>
                </dl>
                <CodeBlock title="Verify SHA-256" code={verify} lang="powershell" />
              </div>
            </details>
          )}

          <details id={id === 'windows' ? 'windows-archives' : undefined} class="disclosure">
            <summary>Archives &amp; checksums <span class="file-count">{items.length} files</span><Icon name="arrow-right" size={14} /></summary>
            <div class="disclosure-content">
              {id === 'linux' && <p class="muted small">Desktop requires compatible GUI libraries. Musl and Linux ARM64 builds are not available.</p>}
              {items.length > 0 ? (
                <div class="table-wrap" tabindex="0" role="region" aria-label={`${title} archive downloads`}>
                  <table>
                    <caption class="visually-hidden">{title} release assets</caption>
                    <thead><tr><th scope="col">Architecture</th><th scope="col">App</th><th scope="col">File</th><th scope="col">Size</th><th scope="col">SHA-256</th></tr></thead>
                    <tbody>
                      {items.map((archive) => (
                        <tr>
                          <td>{archive.target.startsWith('aarch64') ? 'Apple silicon' : id === 'macos' ? 'Intel' : 'x64'}</td>
                          <td>{archive.application === 'cli' ? 'CLI' : 'Desktop'}</td>
                          <td><a href={archive.url} title={archive.fileName}>{archive.format.toUpperCase()}</a></td>
                          <td>{formatSize(archive.size)}</td>
                          <td><a class="checksum" href={`${archive.url}.sha256`} title={archive.sha256}>{archive.sha256.slice(0, 12)}…</a></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : <p class="muted small">Archives are unavailable. Build from source below.</p>}
            </div>
          </details>
        </div>
      </section>
    ))}

    <p class="security-note">Install scripts verify SHA-256. Unsigned apps may trigger Windows SmartScreen or macOS Gatekeeper warnings. Terminal commands execute the linked install scripts.</p>

    <details id="source-heading" class="source disclosure">
      <summary><h2>Build from source</h2><Icon name="arrow-right" size={18} /></summary>
      <div class="disclosure-content">
        <p class="muted small">Requires stable Rust. Chromium is managed automatically; no Node or Playwright installation is needed.</p>
        <CodeBlock title="CLI" code={fromSource} lang="sh" />
        <CodeBlock title="Desktop" code={desktopFromSource} lang="sh" />
        <p class="muted small">Windows desktop builds also need the Visual Studio C++ build tools and Windows SDK.</p>
        <div class="links">
          <a href="/docs/getting-started/">Getting started <Icon name="arrow-right" size={14} /></a>
          {repoUrl && <a href={repoUrl}>Source on GitHub <Icon name="github" size={14} /></a>}
        </div>
      </div>
    </details>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 48px 16px;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }

  .heading p {
    margin-top: 12px;
  }

  h1 {
    font-size: 2.25rem;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .release-version {
    padding-top: 9px;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .platform-nav {
    display: flex;
    gap: 28px;
    margin-top: 28px;
    border-bottom: 1px solid var(--border);
  }

  .platform-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 10px;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .platform-nav a:hover,
  .platform-nav a:focus-visible {
    color: var(--foreground);
    border-bottom-color: var(--foreground);
  }

  .platform {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 48px;
    padding-block: 36px;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  h2 {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  .platform-subtitle {
    margin-top: 6px;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }

  .platform-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px;
    margin-top: 20px;
  }

  .file-size {
    flex-basis: 100%;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }

  .platform-content {
    min-width: 0;
  }

  .platform-content :global(pre),
  .source :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .script-link {
    display: inline-block;
    margin-block: 10px 16px;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }

  .disclosure {
    min-width: 0;
    border-top: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-block: 12px;
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex: none;
    margin-left: auto;
    transition: transform var(--duration-fast);
  }

  details[open] > summary :global(svg) {
    transform: rotate(90deg);
  }

  .file-count {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }

  .disclosure-content {
    display: grid;
    gap: 20px;
    min-width: 0;
    padding-block: 8px 20px;
  }

  .details {
    display: grid;
    margin: 0;
    font-size: var(--text-sm);
  }

  .details div {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 16px;
    padding-block: 9px;
    border-bottom: 1px solid var(--border);
  }

  dt {
    color: var(--muted-foreground);
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  .hash,
  dd code {
    overflow-wrap: anywhere;
  }

  .notice {
    margin-top: 24px;
    padding: 14px 18px;
    border-left: 3px solid var(--info);
    background: var(--muted);
    font-size: var(--text-sm);
  }

  .small,
  .security-note {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .security-note {
    max-width: 80ch;
    margin-block: 24px;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }

  .source > summary {
    padding-block: 20px;
  }

  .source h2 {
    font-size: var(--text-lg);
  }

  .source .disclosure-content {
    max-width: 760px;
  }

  .table-wrap {
    overflow-x: auto;
    width: 100%;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  caption {
    padding-bottom: var(--space-xs);
    font-weight: var(--weight-medium);
    text-align: left;
  }

  th,
  td {
    padding: 10px 12px;
    border-bottom: var(--border-width) solid var(--border);
    text-align: left;
    white-space: nowrap;
  }

  th {
    color: var(--muted-foreground);
    font-weight: var(--weight-medium);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
  }

  @media (max-width: 699px) {
    .page {
      padding-top: 32px;
    }

    h1 {
      font-size: 1.875rem;
    }

    .platform {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-block: 28px;
    }

    .platform-overview {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
    }

    .platform-actions {
      margin-top: 0;
    }
  }

  @media (max-width: 419px) {
    .platform-overview {
      display: grid;
    }
  }
</style>
