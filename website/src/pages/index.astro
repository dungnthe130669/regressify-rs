---
import { Image } from 'astro:assets';
import overview from '../assets/docs/desktop/overview.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Icon from '../components/Icon.astro';
import ReleaseMeta from '../components/ReleaseMeta.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Visual regression testing</p>
      <h1>Regressify</h1>
      <p class="lead">
        Catch visual changes before your users do.<br class="desktop-break" />
        From your desktop or your CI pipeline.
      </p>
      <div class="cta">
        <div class="cta-buttons">
          <DownloadButton />
          <Button size="lg" variant="ghost" href="/docs/getting-started/">
            Get started
            <Icon name="arrow-right" />
          </Button>
        </div>
        <ReleaseMeta />
      </div>
    </div>
  </section>

  <section class="product" aria-label="Regressify Desktop">
    <div class="container">
      <a class="product-link" href="/docs/desktop-app/" aria-label="Explore Regressify Desktop">
        <Image
          src={overview}
          alt="Regressify Desktop workspace listing test suites with capture, run, and review actions."
          widths={[640, 960, 1600]}
          sizes="(max-width: 1080px) 100vw, 1016px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="product-image"
        />
      </a>
      <div class="product-caption">
        <span>Capture. Compare. Approve.</span>
        <a href="/docs/desktop-app/">Explore the desktop app <Icon name="arrow-right" size={14} /></a>
      </div>
      <ul class="highlights" aria-label="At a glance">
        <li><Icon name="layout-dashboard" size={18} /> Desktop &amp; CLI</li>
        <li><Icon name="globe" size={18} /> Managed Chromium</li>
        <li><Icon name="file-text" size={18} /> YAML &amp; JSON suites</li>
      </ul>
    </div>
  </section>

  <section class="install" aria-labelledby="terminal-install">
    <div class="container">
      <div class="section-heading">
        <h2 id="terminal-install">Install from your terminal</h2>
        <a href="/download/">All downloads <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="commands">
        <div class="command">
          <CodeBlock title="Windows · PowerShell" lang="powershell" code="irm https://regressify.eshn.dev/install.ps1 | iex" />
          <a class="script-link" href="/install.ps1">Review PowerShell script</a>
        </div>
        <div class="command">
          <CodeBlock title="macOS & Linux" lang="sh" code="curl -fsSL https://regressify.eshn.dev/install.sh | sh" />
          <a class="script-link" href="/install.sh">Review shell script</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 64px 40px;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  h1 {
    font-size: 3.5rem;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .lead {
    max-width: 48ch;
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .cta {
    display: grid;
    gap: 12px;
    margin-top: 6px;
    width: 100%;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .product-link {
    display: block;
  }

  .product-image {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .product-caption,
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .product-caption {
    padding-block: 14px 28px;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }

  .product-caption a,
  .section-heading a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 40px;
    margin: 0;
    padding: 24px 0;
    border-block: 1px solid var(--border);
    list-style: none;
  }

  .highlights li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
  }

  .install {
    padding-block: 48px 16px;
  }

  h2 {
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .commands {
    display: grid;
    gap: 24px;
    margin-top: 24px;
  }

  .command {
    min-width: 0;
  }

  .command :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .script-link {
    display: inline-block;
    margin-top: 10px;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  @media (min-width: 900px) {
    .commands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 479px) {
    .hero {
      padding-block: 36px 28px;
    }

    h1 {
      font-size: 2.5rem;
    }

    .desktop-break {
      display: none;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .highlights {
      gap: 16px 24px;
    }
  }
</style>
