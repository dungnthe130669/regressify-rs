{
  "$schema": "mcp-worker/node_modules/wrangler/config-schema.json",
  "name": "regressify",
  "main": "worker/index.ts",
  "tsconfig": "tsconfig.worker.json",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "upload_source_maps": false,
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/mcp",
      "/admin",
      "/admin/*"
    ]
  },
  "keep_vars": true
}